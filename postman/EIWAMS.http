# EIWAMS API requests for the VS Code REST Client extension / Visual Studio .http support.
# Start the API first:  cd EIWAMS.API; func start --port 7274
# Ids and row versions are taken from earlier named requests; run requests top to bottom.

@baseUrl = http://localhost:7274/api
@userId = 1
@hrUserId = 2
@managerUserId = 3
@securityUserId = 4
@facilityAdminUserId = 5
@receptionUserId = 6
@eshaUserId = 7
@accessControlUserId = 13
@auditorUserId = 8
@eshaEmployeeId = 6
@roleId = 8
@validFromUtc = 2027-01-01T00:00:00Z
@validToUtc = 2027-01-31T00:00:00Z
@visitorPassToUtc = 2027-01-01T18:00:00Z
@notificationId = {{getNotifications.response.body.$.data.items[0].notificationId}}
@employeeId = {{createEmployee.response.body.$.data.employeeId}}
@employeeVersion = {{getEmployee.response.body.$.data.version}}
@cardId = {{createCard.response.body.$.data.cardId}}
@cardVersion = {{activateCard.response.body.$.data.version}}
@newCardId = {{replaceCard.response.body.$.data.cardId}}
@newCardVersion = {{replaceCard.response.body.$.data.version}}
@cardRequestId = {{createCardRequest.response.body.$.data.cardRequestId}}
@accessRequestId = {{createAccessRequest.response.body.$.data.accessRequestId}}
@accessRequestVersion = {{getAccessRequest.response.body.$.data.version}}
@permissionId = {{provisionPermission.response.body.$.data.permissionId}}
@cancelRequestId = {{createAccessRequest_ToCancel.response.body.$.data.accessRequestId}}
@cancelRequestVersion = {{createAccessRequest_ToCancel.response.body.$.data.version}}
@revokePassId = {{createVisitorPass_ToRevoke.response.body.$.data.visitorPassId}}
@grantedPermissionIds = [1, 2, 3]
@violationId = {{searchViolations.response.body.$.data.items[0].violationId}}
@incidentId = {{createIncident.response.body.$.data.incidentId}}
@incidentVersion = {{getIncident.response.body.$.data.version}}
@visitorId = {{createVisitor.response.body.$.data.visitorId}}
@visitorPassId = {{createVisitorPass.response.body.$.data.visitorPassId}}
@blacklistId = {{createBlacklistEntry.response.body.$.data.blacklistId}}
@adminUserId = {{createAdminUser.response.body.$.data.userId}}
@departmentId = {{createDepartment.response.body.$.data.departmentId}}
@locationId = {{createLocation.response.body.$.data.locationId}}
@readerId = {{createReader.response.body.$.data.readerId}}

### ===== Identity =====

### GetAuthConfig
# @name getAuthConfig
GET {{baseUrl}}/auth/config

### GetDevUsers
# @name getDevUsers
GET {{baseUrl}}/v1/dev/users

### GetMe
# @name getMe
GET {{baseUrl}}/v1/me
X-User-Id: {{eshaUserId}}

### GetMyMenu
# @name getMyMenu
GET {{baseUrl}}/v1/me/menu
X-User-Id: {{eshaUserId}}

### GetLookups
# @name getLookups
GET {{baseUrl}}/v1/lookups
X-User-Id: {{userId}}

### GetNotifications
# @name getNotifications
GET {{baseUrl}}/v1/notifications?unreadOnly=false&page=1&pageSize=20
X-User-Id: {{eshaUserId}}

### GetUnreadNotificationCount
# @name getUnreadNotificationCount
GET {{baseUrl}}/v1/notifications/unread-count
X-User-Id: {{eshaUserId}}

### MarkNotificationRead
# @name markNotificationRead
POST {{baseUrl}}/v1/notifications/{{notificationId}}/read
X-User-Id: {{eshaUserId}}
Content-Type: application/json

{}

### MarkAllNotificationsRead
# @name markAllNotificationsRead
POST {{baseUrl}}/v1/notifications/read-all
X-User-Id: {{eshaUserId}}
Content-Type: application/json

{}

### ===== Employees =====

### SearchEmployees
# @name searchEmployees
GET {{baseUrl}}/v1/employees?search=Patel&employmentStatus=Active&page=1&pageSize=20
X-User-Id: {{hrUserId}}

### CreateEmployee
# @name createEmployee
POST {{baseUrl}}/v1/employees
X-User-Id: {{hrUserId}}
Content-Type: application/json

{
  "employeeNumber": "EMP{{$randomInt 100 999}}{{$randomInt 100 999}}",
  "firstName": "Ananya",
  "lastName": "Iyer",
  "workEmail": "ananya.iyer.{{$randomInt 100 999}}@eiwams.example.com",
  "employeeType": "Permanent",
  "departmentId": 1,
  "managerEmployeeId": 1,
  "locationId": 7,
  "joinDate": "2026-01-05",
  "endDate": null,
  "userId": null
}

### GetEmployee
# @name getEmployee
GET {{baseUrl}}/v1/employees/{{employeeId}}
X-User-Id: {{hrUserId}}

### UpdateEmployee
# @name updateEmployee
PUT {{baseUrl}}/v1/employees/{{employeeId}}
X-User-Id: {{hrUserId}}
Content-Type: application/json

{
  "firstName": "Ananya",
  "lastName": "Iyer-Rao",
  "workEmail": "ananya.iyer.{{$randomInt 100 999}}@eiwams.example.com",
  "employeeType": "Permanent",
  "departmentId": 1,
  "managerEmployeeId": 1,
  "locationId": 7,
  "joinDate": "2026-01-05",
  "endDate": null,
  "userId": null,
  "version": "{{employeeVersion}}"
}

### TransferEmployee
# @name transferEmployee
POST {{baseUrl}}/v1/employees/{{employeeId}}/transfer
X-User-Id: {{hrUserId}}
Content-Type: application/json

{
  "departmentId": 2,
  "managerEmployeeId": 1,
  "locationId": 8,
  "effectiveDate": "2026-02-01",
  "reason": "Project reallocation"
}

### GetEmployeeCards
# @name getEmployeeCards
GET {{baseUrl}}/v1/employees/{{eshaEmployeeId}}/cards
X-User-Id: {{hrUserId}}

### GetEmployeeHistory
# @name getEmployeeHistory
GET {{baseUrl}}/v1/employees/{{employeeId}}/history
X-User-Id: {{hrUserId}}

### ===== Cards =====

### SearchCards
# @name searchCards
GET {{baseUrl}}/v1/cards?status=Active&page=1&pageSize=20
X-User-Id: {{securityUserId}}

### CreateCard
# @name createCard
POST {{baseUrl}}/v1/cards
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "employeeId": {{employeeId}},
  "cardUid": "04C9{{$randomInt 100 999}}{{$randomInt 100 999}}{{$randomInt 100 999}}",
  "cardType": "Permanent",
  "expiresAtUtc": null,
  "cardRequestId": null
}

### ActivateCard
# @name activateCard
POST {{baseUrl}}/v1/cards/{{cardId}}/activate
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "version": "{{cardVersion}}"
}

### ReportLostCard
# @name reportLostCard
POST {{baseUrl}}/v1/cards/{{cardId}}/report-lost
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "reason": "Card lost during commute"
}

### ReplaceCard
# @name replaceCard
POST {{baseUrl}}/v1/cards/{{cardId}}/replace
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "newCardUid": "04D7{{$randomInt 100 999}}{{$randomInt 100 999}}{{$randomInt 100 999}}",
  "reason": "Replacement for lost card",
  "version": "{{cardVersion}}"
}

### BlockCard
# @name blockCard
POST {{baseUrl}}/v1/cards/{{newCardId}}/block
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "reason": "Suspicious activity reported",
  "version": "{{newCardVersion}}"
}

### DeactivateCard
# @name deactivateCard
POST {{baseUrl}}/v1/cards/{{newCardId}}/deactivate
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "reason": "Employee exit",
  "version": "{{newCardVersion}}"
}

### SearchCardRequests
# @name searchCardRequests
GET {{baseUrl}}/v1/card-requests?status=PendingManager&page=1&pageSize=20
X-User-Id: {{securityUserId}}

### CreateCardRequest
# @name createCardRequest
POST {{baseUrl}}/v1/card-requests
X-User-Id: {{hrUserId}}
Content-Type: application/json

{
  "employeeId": {{employeeId}},
  "requestType": "New",
  "reason": null,
  "mobileNumber": "+91 90000 12345",
  "address": "Bengaluru",
  "bloodGroup": "O+",
  "emergencyContactName": "Demo Contact",
  "emergencyContactNumber": "+91 90000 12346",
  "photoContentType": "image/jpeg",
  "photoBase64": "/9j/"
}

### GetCardRequest
# @name getCardRequest
GET {{baseUrl}}/v1/card-requests/{{cardRequestId}}
X-User-Id: {{managerUserId}}

### DecideCardRequest
# @name decideCardRequest
POST {{baseUrl}}/v1/card-requests/{{cardRequestId}}/decision
X-User-Id: {{managerUserId}}
Content-Type: application/json

{
  "action": "Approve",
  "comments": "Identity verified at desk",
  "version": "{{getCardRequest.response.body.$.data.version}}"
}

### DeactivateEmployee
# @name deactivateEmployee
POST {{baseUrl}}/v1/employees/{{employeeId}}/deactivate
X-User-Id: {{hrUserId}}
Content-Type: application/json

{
  "employmentStatus": "Exited",
  "endDate": "2026-12-31",
  "reason": "Resigned"
}

### ===== Access =====

### SearchAccessRequests
# @name searchAccessRequests
GET {{baseUrl}}/v1/access-requests?mine=true&page=1&pageSize=20
X-User-Id: {{eshaUserId}}

### CreateAccessRequest
# @name createAccessRequest
POST {{baseUrl}}/v1/access-requests
X-User-Id: {{eshaUserId}}
Content-Type: application/json

{
  "employeeId": {{eshaEmployeeId}},
  "accessType": "WingFloor",
  "buildingLocationId": 2,
  "locationId": 10,
  "durationCode": "Custom",
  "validFromUtc": "{{validFromUtc}}",
  "validToUtc": "{{validToUtc}}",
  "justification": "Prototype validation in the R&D lab"
}

### GetAccessRequest
# @name getAccessRequest
GET {{baseUrl}}/v1/access-requests/{{accessRequestId}}
X-User-Id: {{eshaUserId}}

### GetPendingApprovals
# @name getPendingApprovals
GET {{baseUrl}}/v1/approvals/pending?page=1&pageSize=20
X-User-Id: {{managerUserId}}

### DecideApproval - Stage 1 of 3 (Manager).
# @name decideApproval
POST {{baseUrl}}/v1/approvals/{{accessRequestId}}/decision
X-User-Id: {{managerUserId}}
Content-Type: application/json

{
  "decision": "Approve",
  "comments": "Approved by line manager",
  "version": "{{accessRequestVersion}}"
}

### DecideApproval - Security - Stage 2 of 3 (WingFloor requests).
# @name decideApproval_Security
POST {{baseUrl}}/v1/approvals/{{accessRequestId}}/decision
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "decision": "Approve",
  "comments": "Security clearance verified",
  "version": "{{getAccessRequest.response.body.$.data.version}}"
}

### DecideApproval - AccessControl - Stage 3 of 3; the request becomes Approved.
# @name decideApproval_AccessControl
POST {{baseUrl}}/v1/approvals/{{accessRequestId}}/decision
X-User-Id: {{accessControlUserId}}
Content-Type: application/json

{
  "decision": "Approve",
  "comments": "Capacity available",
  "version": "{{getAccessRequest.response.body.$.data.version}}"
}

### ProvisionPermission - Requires the request to be fully Approved (all three stages).
# @name provisionPermission
POST {{baseUrl}}/v1/permissions/provision
X-User-Id: {{accessControlUserId}}
Content-Type: application/json

{
  "accessRequestId": {{accessRequestId}}
}

### SearchPermissions
# @name searchPermissions
GET {{baseUrl}}/v1/permissions?status=Active&page=1&pageSize=20
X-User-Id: {{accessControlUserId}}

### RevokePermission
# @name revokePermission
POST {{baseUrl}}/v1/permissions/{{permissionId}}/revoke
X-User-Id: {{facilityAdminUserId}}
Content-Type: application/json

{
  "reason": "Project completed"
}

### CreateAccessRequest - ToCancel
# @name createAccessRequest_ToCancel
POST {{baseUrl}}/v1/access-requests
X-User-Id: {{eshaUserId}}
Content-Type: application/json

{
  "employeeId": {{eshaEmployeeId}},
  "accessType": "Building",
  "buildingLocationId": 2,
  "locationId": 9,
  "durationCode": "Custom",
  "validFromUtc": "{{validFromUtc}}",
  "validToUtc": "{{validToUtc}}",
  "justification": "Quarterly planning sessions on floor 5"
}

### CancelAccessRequest
# @name cancelAccessRequest
POST {{baseUrl}}/v1/access-requests/{{cancelRequestId}}/cancel
X-User-Id: {{eshaUserId}}
Content-Type: application/json

{
  "reason": "No longer required",
  "version": "{{cancelRequestVersion}}"
}

