### SearchVisitorPasses
# @name searchVisitorPasses
GET {{baseUrl}}/v1/visitor-passes?page=1&pageSize=20
X-User-Id: {{receptionUserId}}

### CreateVisitorPass
# @name createVisitorPass
POST {{baseUrl}}/v1/visitor-passes
X-User-Id: {{receptionUserId}}
Content-Type: application/json

{
  "visitorId": {{visitorId}},
  "locationId": 5,
  "validFromUtc": "{{$datetime iso8601}}",
  "validToUtc": "{{visitorPassToUtc}}",
  "sponsorUserId": 3
}

### ApproveVisitorPass
# @name approveVisitorPass
POST {{baseUrl}}/v1/visitor-passes/{{visitorPassId}}/approve
X-User-Id: {{facilityAdminUserId}}
Content-Type: application/json

{
  "comments": "Approved"
}

### CheckInVisitorPass
# @name checkInVisitorPass
POST {{baseUrl}}/v1/visitor-passes/{{visitorPassId}}/check-in
X-User-Id: {{receptionUserId}}
Content-Type: application/json

{}

### CheckOutVisitorPass
# @name checkOutVisitorPass
POST {{baseUrl}}/v1/visitor-passes/{{visitorPassId}}/check-out
X-User-Id: {{receptionUserId}}
Content-Type: application/json

{}

### CreateVisitorPass - ToRevoke
# @name createVisitorPass_ToRevoke
POST {{baseUrl}}/v1/visitor-passes
X-User-Id: {{receptionUserId}}
Content-Type: application/json

{
  "visitorId": {{visitorId}},
  "locationId": 5,
  "validFromUtc": "{{$datetime iso8601}}",
  "validToUtc": "{{visitorPassToUtc}}",
  "sponsorUserId": 3
}

### RevokeVisitorPass
# @name revokeVisitorPass
POST {{baseUrl}}/v1/visitor-passes/{{revokePassId}}/revoke
X-User-Id: {{receptionUserId}}
Content-Type: application/json

{
  "reason": "Visit cancelled"
}

### ===== RFID & Security =====

### IngestRfidEvent
# @name ingestRfidEvent
POST {{baseUrl}}/v1/rfid/events
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "readerId": "RDR-BLR-ODC1-01",
  "externalEventId": "evt-{{$guid}}",
  "cardUid": "04A10000000007",
  "eventType": "Entry",
  "eventAtUtc": "{{$datetime iso8601}}"
}

### SearchRfidEvents
# @name searchRfidEvents
GET {{baseUrl}}/v1/rfid/events?decision=Denied&page=1&pageSize=20
X-User-Id: {{securityUserId}}

### SearchViolations
# @name searchViolations
GET {{baseUrl}}/v1/violations?status=Open&page=1&pageSize=20
X-User-Id: {{securityUserId}}

### ReviewViolation
# @name reviewViolation
POST {{baseUrl}}/v1/violations/{{violationId}}/review
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "status": "Confirmed",
  "reviewNotes": "Verified with CCTV footage",
  "createIncident": false
}

### SearchIncidents
# @name searchIncidents
GET {{baseUrl}}/v1/incidents?page=1&pageSize=20
X-User-Id: {{securityUserId}}

### CreateIncident
# @name createIncident
POST {{baseUrl}}/v1/incidents
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "title": "Tailgating at ODC1",
  "description": "Two people entered on a single swipe.",
  "incidentType": "Tailgating",
  "severity": "High",
  "violationId": null,
  "locationId": 7,
  "assignedToUserId": 4
}

### GetIncident
# @name getIncident
GET {{baseUrl}}/v1/incidents/{{incidentId}}
X-User-Id: {{securityUserId}}

### UpdateIncident
# @name updateIncident
PATCH {{baseUrl}}/v1/incidents/{{incidentId}}
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "status": "UnderReview",
  "assignedToUserId": 4,
  "resolution": null,
  "note": "Reviewing CCTV",
  "version": "{{incidentVersion}}"
}

### SearchBlacklist
# @name searchBlacklist
GET {{baseUrl}}/v1/blacklist?isActive=true&page=1&pageSize=20
X-User-Id: {{securityUserId}}

### CreateBlacklistEntry
# @name createBlacklistEntry
POST {{baseUrl}}/v1/blacklist
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "subjectType": "Visitor",
  "subjectId": {{visitorId}},
  "reason": "Repeated policy violations",
  "reviewDate": "2027-06-30"
}

### LiftBlacklistEntry
# @name liftBlacklistEntry
POST {{baseUrl}}/v1/blacklist/{{blacklistId}}/lift
X-User-Id: {{securityUserId}}
Content-Type: application/json

{
  "reason": "Review completed"
}

