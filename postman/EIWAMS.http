# @name createAdminUser
POST {{baseUrl}}/v1/admin/users
X-User-Id: {{userId}}
Content-Type: application/json

{
  "displayName": "Neha Kulkarni",
  "email": "neha.kulkarni.{{$randomInt 100 999}}@eiwams.example.com",
  "entraObjectId": null,
  "isActive": true,
